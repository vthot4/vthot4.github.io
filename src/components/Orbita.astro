---
// Ilustración decorativa: átomo/órbitas con kanji 探究 (indagación, investigación).
---
<svg class="orbita" viewBox="0 0 400 400" role="img" aria-label="Órbitas atómicas con el kanji 探究" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="halo" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="var(--c-ciencia)" stop-opacity=".35" />
      <stop offset="1" stop-color="var(--c-ciencia)" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="200" cy="200" r="190" fill="url(#halo)" />
  <g class="lineas" stroke="var(--border)" stroke-width="1">
    <line x1="200" y1="0" x2="200" y2="400" />
    <line x1="0" y1="200" x2="400" y2="200" />
    <circle cx="200" cy="200" r="150" fill="none" stroke-dasharray="2 6" />
  </g>
  <text x="200" y="228" text-anchor="middle" class="kanji">探究</text>
  <g class="anillo a1"><ellipse cx="200" cy="200" rx="170" ry="62" fill="none" stroke="var(--c-ciencia)" stroke-width="1.5" /><circle cx="370" cy="200" r="6" fill="var(--c-ciencia)" /></g>
  <g class="anillo a2"><ellipse cx="200" cy="200" rx="170" ry="62" fill="none" stroke="var(--accent)" stroke-width="1.5" /><circle cx="30" cy="200" r="6" fill="var(--accent)" /></g>
  <g class="anillo a3"><ellipse cx="200" cy="200" rx="170" ry="62" fill="none" stroke="var(--c-naturaleza)" stroke-width="1.5" /><circle cx="200" cy="138" r="5" fill="var(--c-naturaleza)" /></g>
</svg>
